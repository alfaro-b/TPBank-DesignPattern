@startuml

title TP Bank - Diagramme de classes global

top to bottom direction

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 60
skinparam ranksep 60

package application <<Folder>> #EAF4FF {

    class Main

    class BankConsole

}

package business <<Folder>> #F3ECFF {

    class BankService

}

package dao <<Folder>> #EAF0FF {

    interface ClientDAO {
        + findById(id : int) : Client
        + findAll() : List<Client>
    }

    interface AccountDAO {
        + findById(id : int) : Account
        + findByClientId(clientId : int) : List<Account>
        + update(account : Account) : void
    }

    interface OperationDAO {
        + save(operation : Operation) : void
        + findByAccountId(accountId : int) : List<Operation>
    }

    package impl <<Folder>> #DCE8FF {

        class ClientDAOImpl {
            - connection : Connection
        }

        class AccountDAOImpl {
            - connection : Connection
        }

        class OperationDAOImpl {
            - connection : Connection
        }

    }

    ClientDAO <|.. ClientDAOImpl
    AccountDAO <|.. AccountDAOImpl
    OperationDAO <|.. OperationDAOImpl

}

package entities <<Folder>> #EAFBF0 {

    class Client {
        - id : int
        - firstName : String
        - lastName : String
        - email : String
    }

    abstract class Account {
        - id : int
        - accountNumber : String
        - balance : BigDecimal
        + deposit(amount : BigDecimal) : void
        + withdraw(amount : BigDecimal) : void
    }

    class CurrentAccount

    class SavingsAccount {
        - interestRate : BigDecimal
        + calculateInterest() : BigDecimal
    }

    class Operation {
        + {static} DEPOSIT : String {readOnly}
        + {static} WITHDRAWAL : String {readOnly}
        - id : int
        - amount : BigDecimal
        - type : String
        - date : LocalDateTime
    }

    Client "1" <-- "0..*" Account : appartient à
    Account "1" <-- "0..*" Operation

    Account <|-- CurrentAccount
    Account <|-- SavingsAccount

}

package singleton <<Folder>> #FFF1DD {

    class DatabaseConnection <<Singleton>> {
        - {static} instance : DatabaseConnection
        - url : String
        - user : String
        - password : String
        - connection : Connection
        - DatabaseConnection()
        + {static} getInstance() : DatabaseConnection
        + getConnection() : Connection
    }

}

package factory <<Folder>> #E8FCF7 {

    class AccountFactory <<Factory>> {
        + {static} createAccount(type : String, id : int, accountNumber : String, balance : BigDecimal, client : Client, interestRate : BigDecimal) : Account
    }

}

package exception <<Folder>> #FFECEC {

    class AccountNotFoundException

    class InsufficientBalanceException

    class InvalidAmountException

}

' Interface utilisateur

Main ..> BankConsole

BankConsole --> BankService #9333EA

' Couche métier vers les interfaces DAO

BankService -down--> ClientDAO #2563EB
BankService -down--> AccountDAO #2563EB
BankService -down--> OperationDAO #2563EB

' Gestion des exceptions

BankService -right..> AccountNotFoundException #DC2626
BankService -right..> InsufficientBalanceException #DC2626
BankService -right..> InvalidAmountException #DC2626

' Singleton

ClientDAOImpl -right..> DatabaseConnection #D97706
AccountDAOImpl -right..> DatabaseConnection #D97706
OperationDAOImpl -right..> DatabaseConnection #D97706

' Factory

AccountDAOImpl ..> AccountFactory #0D9488

AccountFactory ..> Account #16A34A 

' Liens invisibles pour organiser la disposition

application -[hidden]down-> business
business -[hidden]down-> dao
dao -[hidden]right-> entities
dao -[hidden]right-> singleton
business -[hidden]right-> exception

@enduml