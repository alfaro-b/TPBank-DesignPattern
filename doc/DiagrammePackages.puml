@startuml

title TP Bank - Diagramme de packages

top to bottom direction

skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 30
skinparam linetype ortho

folder application #EAF4FF {
    card "Main\nBankConsole"
}

folder business #F3ECFF {
    card "Règles métier\nBankService"
}

folder dao #EAF0FF {

    card "Interfaces DAO\nContrats d'accès aux données" as daoInterfaces

    folder "impl" as daoImpl #DCE8FF {
        card "Implémentations DAO\nRequêtes SQL"
    }

}

folder entities #EAFBF0 {
    card "Client, Account,\nOperation..."
}

folder singleton #FFF1DD {
    card "DatabaseConnection\nGestion de la connexion JDBC"
}

folder factory #E8FCF7 {
    card "AccountFactory\nCréation des comptes"
}

folder exception #FFECEC {
    card "Exceptions métier"
}

database MySQL #F7F7F7

' Dépendances entre les packages

application -down..> business

business -down..> dao
business -down..> entities
business -right..> exception

dao -down..> entities

daoImpl -down..> factory
daoImpl -down..> singleton

factory -down..> entities

singleton -down-> MySQL

' Liens invisibles pour organiser la disposition

application -[hidden]down-> business
business -[hidden]down-> dao

factory -[hidden]right-> singleton
entities -[hidden]right-> MySQL
@enduml